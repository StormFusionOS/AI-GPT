# Shared settings
PROJECT_NAME=ai-seo-dashboard
ENVIRONMENT=development
API_BASE_URL=http://localhost:8000

# Backend
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_seo_dashboard
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your-qdrant-key
MEDIA_ROOT=media
BACKUP_ROOT=/mnt/backup
BACKUP_RETENTION_COUNT=7
APP_LOG_PATH=logs/app.log
TASK_LOG_PATH=logs/tasks.log
SCHEDULER_STATE_PATH=storage/schedules.json
ALERTS_STATE_PATH=storage/alerts.json
INTEGRITY_STATE_PATH=storage/integrity_checksums.json
# Comma separated file paths to monitor for integrity changes
INTEGRITY_WATCH_PATHS=.env,backend/app/core/config.py
# Optional WordPress site configuration encoded as JSON list of objects
# WORDPRESS_SITES=[{"name":"Marketing Site","base_url":"https://example.com","username":"automation","application_password":"app-password"}]

# Frontend
VITE_API_BASE_URL=http://localhost:8000
